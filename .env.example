# Supabase project: Nomad Life
# Supabase browser/client values.
# These can be exposed to the Vercel frontend after RLS is configured.
VITE_SUPABASE_URL=https://ikeubpdajcuqlvbvvhbq.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
NOMAD_DASHBOARD_MODE=local

# Mac-only worker values. Never expose service role keys in Vercel/browser code.
SUPABASE_URL=https://ikeubpdajcuqlvbvvhbq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Supabase Auth user id that owns hosted Dashboard snapshots and sync logs.
NOMAD_SUPABASE_OWNER_USER_ID=replace-with-auth-user-uuid
